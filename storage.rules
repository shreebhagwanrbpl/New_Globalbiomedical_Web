rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public can read product images and assets
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /recipes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User review images and uploads
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
